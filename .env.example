# Required for Gemini-backed Q&A, quiz, summary, learning path,
# and the default explanation implementation.


# Current Gemini model can be changed without editing Python code.
GEMINI_MODEL=gemini-3.8-flash

# Set true only if requirements-local.txt is installed and you want
# LaMini-Flan-T5-783M to handle the explanation endpoint.
USE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

MAX_OUTPUT_TOKENS=1200
TEMPERATURE=0.3
